# Telegram bot that receives leads from the contact form (create it with @BotFather).
TELEGRAM_BOT_TOKEN=
# Chat that receives the leads: your user id or a group id (see CLAUDE.md, "Leads").
TELEGRAM_CHAT_ID=
# Public Telegram username for the "write in Telegram" link, without @. Empty hides the link.
NEXT_PUBLIC_TELEGRAM_USERNAME=
# Canonical site URL used in metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://firtech.pro
# Yandex Metrika counter id (digits). Create a counter at https://metrika.yandex.ru, then add the
# goals from src/lib/analytics.ts as "JavaScript event" goals. Empty: no analytics script at all.
NEXT_PUBLIC_YM_ID=
# Secret Telegram sends in the X-Telegram-Bot-Api-Secret-Token header to /api/telegram; also signs the
# "follow in Telegram" start links. Any random string of 1-256 chars A-Z a-z 0-9 _ -
# (e.g. `openssl rand -hex 32`). Empty: the webhook rejects everything and the start link is hidden.
TELEGRAM_WEBHOOK_SECRET=
# Bot username (without @) for the "Get replies in Telegram" button after the form. Empty hides it.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=firtech_bot
# Folder for the lead store (leads.json). Must survive deploys on the VPS, e.g. outside the release
# folder. Default: ./data next to the running server.
DATA_DIR=
# Owner panel (/admin) password, server only: the line `node scripts/admin-password.mjs` prints,
# scrypt$<N>$<salt>$<hash> (N 16384 or 32768, salt and hash base64url). Empty or malformed: the login
# is closed ("Password is not set up."). In this file (.env.local, read by `next dev`) write every $
# as \$; in shared/.env.production on the server (node --env-file) paste the line unchanged.
ADMIN_PASSWORD_HASH=
# Pulse traffic panel. Yandex Metrika: OAuth token with the metrika:read scope (read only) and the
# counter id (default 113665084). Empty token: the panel says Metrika is not connected.
METRIKA_TOKEN=
METRIKA_COUNTER_ID=
# Vibely aggregates: secret sent in the x-metrics-secret header to Vibely's /api/internal/metrics.
# URL must be loopback (default http://127.0.0.1:3000/api/internal/metrics).
VIBELY_METRICS_SECRET=
VIBELY_METRICS_URL=
# Lead Intake agent (agents repo): every lead is also POSTed to ${LEAD_INTAKE_URL}/lead with the header
# x-lead-token = LEAD_INTAKE_TOKEN (same value as LEAD_WEBHOOK_TOKEN there). Either empty: no forwarding.
# Best effort: a failure is only logged, the lead is still saved and sent to Telegram.
LEAD_INTAKE_URL=
LEAD_INTAKE_TOKEN=
# Live office (/admin/office): HQ's internal office JSON, loopback only (default
# http://127.0.0.1:8787/office). In development, an empty URL shows built-in mock data.
HQ_OFFICE_URL=
# Secret sent in the x-office-token header (same value as OFFICE_TOKEN in HQ's env). Server only.
HQ_OFFICE_TOKEN=
# Articles approved in HQ (GET <url>?lang=all, no token), default http://127.0.0.1:8787/blog. In
# development an empty value means no HQ articles.
HQ_BLOG_URL=

# Чат-демо приёмщика: HQ POST /chat (по умолчанию http://127.0.0.1:8787/chat, токен = LEAD_INTAKE_TOKEN, если HQ_CHAT_TOKEN не задан)
HQ_CHAT_URL=
HQ_CHAT_TOKEN=
# Site events for the пульт's weekly numbers (POST /api/events -> HQ POST /events, header x-site-token).
# Token = SITE_EVENTS_TOKEN in HQ (or its WEB_CHAT_TOKEN); empty here falls back to HQ_CHAT_TOKEN. URL
# defaults to the origin of HQ_CHAT_URL + /events; in development without both nothing is sent.
SITE_EVENTS_TOKEN=
HQ_EVENTS_URL=
# Пульт (/admin/office): HQ's admin API, loopback only (default http://127.0.0.1:8787/admin). In
# development, an empty URL runs the built-in in-memory mock.
HQ_ADMIN_URL=
# Secret sent in the x-admin-token header (same value as HQ's admin token). Server only. Used by the
# owner's panel only (since 2026-11-23 there is no fallback to HQ_OFFICE_TOKEN).
HQ_ADMIN_TOKEN=
# Scoped secret for the client cabinet (security 2026-11-23, P1-4): sent as x-admin-token on every
# cabinet -> HQ call (clients by-email, threads, documents, uploads, media). HQ accepts it only for
# /admin/clients/:id/* and /admin/clients/by-email (same value as HQ's CABINET_TOKEN). Empty: the
# cabinet falls back to HQ_ADMIN_TOKEN and logs one warning. Generate: `openssl rand -hex 32`.
HQ_CABINET_TOKEN=
# Account deletion asks HQ to anonymize the client (POST /admin/clients/:id/anonymize, best effort, 404 tolerated).
# 0 switches the call off. Default: on.
HQ_ANONYMIZE_ON_DELETE=

# Public status page (/status, GET /api/status): HQ's GET /status. Empty: the origin of LEAD_INTAKE_URL plus
# /status, in production else http://127.0.0.1:8787/status. In development with neither set, a built-in
# mock with two incidents is shown. Free audit (POST /api/audit) uses LEAD_INTAKE_URL and LEAD_INTAKE_TOKEN above.
HQ_STATUS_URL=

# Client cabinet (/[locale]/cabinet): Supabase project (Singapore). Both public values must be set,
# otherwise the cabinet shows "coming soon" and the header link stays hidden. NEXT_PUBLIC values are
# baked in at build time (set them as CI variables, like NEXT_PUBLIC_YM_ID). See docs/cabinet.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional, server only. With it the cabinet button "Delete account" removes the Supabase user at once;
# without it the button creates a support ticket instead. Not needed otherwise.
SUPABASE_SERVICE_ROLE_KEY=
# Optional, server only (2026-11-22). Signs the «Отписаться» links of letters
# (/<locale>/cabinet/unsubscribe?token=...). At least 16 characters, e.g. `openssl rand -base64 32`.
# HQ needs the SAME value to build the links it puts into letters. Unsubscribing also needs
# SUPABASE_SERVICE_ROLE_KEY (no session). Without both the page sends visitors to the cabinet settings.
UNSUBSCRIBE_SECRET=
# The cabinet reads clients from HQ with HQ_ADMIN_URL and HQ_CABINET_TOKEN (fallback HQ_ADMIN_TOKEN):
# GET /clients/by-email, POST /clients, POST /clients/<id>/tickets.

# Call windows booked by HQ (agents P-02): HQ POSTs {slot, leadId, name, contact, locale, source} to /api/slots with the
# header x-hq-token = this value (same value as SITE_BOOKING_TOKEN in HQ's env, else its LEAD_WEBHOOK_TOKEN). Empty:
# the route answers 401 to everyone and HQ makes the owner a «confirm the call» task instead. The window is held in
# leads.json and leaves GET /api/slots; no email goes to the client from here.
SITE_BOOKING_TOKEN=

# Daily backup (scripts/ops/backup.mjs, cron on the VPS, security 2026-11-23 P1-6): leads.json goes to the owner's
# Telegram ONLY encrypted with age to this public key (`age-keygen -o firtech.key` on the owner's machine, paste the
# `age1...` line here; the server needs `age` installed). Empty: only a summary with a warning is sent, never the file.
BACKUP_AGE_RECIPIENT=

# SEO indexing (docs/seo-indexing.md). INDEXNOW_KEY: 32 hex characters (`openssl rand -hex 16`); the site serves it
# at https://firtech.pro/<key>.txt and the deploy pings IndexNow with it (GitHub secret of the same name in the
# production environment). The two NEXT_PUBLIC_ values are the content of the verification meta tags from Google
# Search Console and Yandex Webmaster (GitHub repository variables, inlined at build time); a tag renders only when set.
INDEXNOW_KEY=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
